      "identity": "scikit-image-astronaut"
    },
    {
      "assetId": "at-camera",
      "catalogSourceId": "scikit-image.camera",
      "filename": "sources/asset-tooling-camera.png",
      "title": "Asset-tooling camera source",
      "identity": "scikit-image-camera"
    },
    {
      "assetId": "at-brick",
