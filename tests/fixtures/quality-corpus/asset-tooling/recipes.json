    },
    {
      "assetId": "at-tone-440-seeded-noise",
      "sourceAssetId": "at-tone-440",
      "recipeId": "audio-seeded-noise-mix",
      "filename": "queries/asset-tooling/tone-440-seeded-noise.wav",
